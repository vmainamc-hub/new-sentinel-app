        <value name="AMOUNT">
          <block type="variables_get" id="amt_get">
            <field name="VAR" id="var_stake">Stake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <shadow type="math_number_positive" id="3kg|aa~E~Xna@A5kh[X{" inline="true">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="pred_get">
            <field name="VAR" id="var_prediction">Prediction</field>
          </block>
        </value>
      </block>
