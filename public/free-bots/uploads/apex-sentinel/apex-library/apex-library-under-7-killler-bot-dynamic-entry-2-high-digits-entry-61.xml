                  </block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_ml">
                    <field name="VAR" id="var_max_losses">Max Con. Losses</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO1">
              <block type="text_print" id="print_ml">
                <value name="TEXT">
                  <shadow type="text" id="ml_text">
                    <field name="TEXT">Max losses reached!</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="trade_again" id="trade_again"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="before_purchase" id="before_purchase" deletable="false" x="0" y="1494">
