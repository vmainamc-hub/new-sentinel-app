  <block type="after_purchase" id="after_purchase" x="1045" y="110">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="win_loss">
        <mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="variables_set" id="reset_stake_win">
            <field name="VAR" id="var_stake">Stake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_orig_stake">
                <field name="VAR" id="var_original_stake">Original Stake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_loss_count">
                <field name="VAR" id="var_loss_count">Loss Count</field>
                <value name="VALUE">
                  <block type="math_number" id="zero1">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reset_recovering">
                    <field name="VAR" id="var_is_recovering">Is Recovering</field>
                    <value name="VALUE">
                      <block type="logic_boolean" id="false1">
                        <field name="BOOL">FALSE</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="reset_pred">
                        <field name="VAR" id="var_prediction">Prediction</field>
                        <value name="VALUE">
                          <block type="variables_get" id="get_init_pred">
                            <field name="VAR" id="var_initial_prediction">Initial Prediction</field>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="variables_set" id="set_recovering">
            <field name="VAR" id="var_is_recovering">Is Recovering</field>
            <value name="VALUE">
              <block type="logic_boolean" id="true1">
                <field name="BOOL">TRUE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="5,r-bs;W22aP78_2*|Ql">
                <field name="VAR" id="var_prediction">Prediction</field>
                <value name="VALUE">
                  <block type="variables_get" id="get_rp">
                    <field name="VAR" id="var_recovery_prediction">Recovery Prediction</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="inc_loss_count">
                    <field name="VAR" id="var_loss_count">Loss Count</field>
                    <value name="VALUE">
                      <block type="math_arithmetic" id="add_lc">
                        <field name="OP">ADD</field>
                        <value name="A">
                          <block type="variables_get" id="get_lc">
                            <field name="VAR" id="var_loss_count">Loss Count</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="one1">
                            <field name="NUM">1</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="martingale_stake">
                        <field name="VAR" id="var_stake">Stake</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="mult_stake">
                            <field name="OP">MULTIPLY</field>
                            <value name="A">
                              <block type="variables_get" id="get_stake2">
                                <field name="VAR" id="var_stake">Stake</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="get_mart">
                                <field name="VAR" id="var_martingale">Martingale</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <next>
          <block type="controls_if" id="check_stop">
            <mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare" id="tp_check">
                <field name="OP">GTE</field>
                <value name="A">
                  <block type="total_profit" id="get_profit"></block>
                </value>
                <value name="B">
                  <block type="variables_get" id="get_tp">
                    <field name="VAR" id="var_take_profit">Take Profit</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="text_print" id="print_tp">
                <value name="TEXT">
                  <shadow type="text" id="tp_text">
                    <field name="TEXT">Take Profit reached!</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <value name="IF1">
              <block type="logic_compare" id="ml_check">
                <field name="OP">GT</field>
                <value name="A">
